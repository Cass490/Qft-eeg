    style Input fill:#e6f3ff,stroke:#0066cc,stroke-width:2px
    style Encoder fill:#e6ffe6,stroke:#00cc00,stroke-width:2px
    style Decoder fill:#e6ffe6,stroke:#00cc00,stroke-width:2px
    style H fill:#fff9e6,stroke:#ff9900,stroke-width:2px
